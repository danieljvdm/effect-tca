{
  "name": "@yielded/tca",
  "version": "0.1.0-beta.0",
  "description": "Composable state, scoped effects, and feature testing for Effect.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/effect-tca.git",
    "directory": "packages/tca"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./FeatureEffect": {
      "types": "./dist/FeatureEffect.d.mts",
      "import": "./dist/FeatureEffect.mjs"
    },
    "./Feature": {
      "types": "./dist/Feature.d.mts",
      "import": "./dist/Feature.mjs"
    },
    "./Store": {
      "types": "./dist/Store.d.mts",
      "import": "./dist/Store.mjs"
    },
    "./TestStore": {
      "types": "./dist/TestStore.d.mts",
      "import": "./dist/TestStore.mjs"
    },
    "./StoreError": {
      "types": "./dist/StoreError.d.mts",
      "import": "./dist/StoreError.mjs"
    },
    "./atom": {
      "types": "./dist/atom.d.mts",
      "import": "./dist/atom.mjs"
    },
    "./atom/FeatureAtom": {
      "types": "./dist/atom/FeatureAtom.d.mts",
      "import": "./dist/atom/FeatureAtom.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check --strict",
    "test": "vp test --passWithNoTests"
  },
  "dependencies": {
    "immer": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
