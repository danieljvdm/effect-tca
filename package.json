{
  "name": "yielded-tca-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check --strict && vp run -r typecheck",
    "check": "vp check && vp run typecheck",
    "test": "vp run -r --concurrency-limit 4 test",
    "build": "vp run -r build",
    "ready": "vp run build && vp run check && vp run test && vp run release:check",
    "changeset": "changeset",
    "changeset:pre": "changeset pre",
    "changeset:version": "changeset version"
  },
